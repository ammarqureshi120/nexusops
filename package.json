{
  "name": "nexusops",
  "version": "0.0.0",
  "private": true,
  "description": "NexusOps multi-tenant operations platform workspace",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.34.5 <11"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter \"./apps/*\" dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,mjs}\" \".github/**/*.{yaml,yml}\" \"*.{json,yaml,yml}\"",
    "format:write": "prettier --write \"apps/**/*.{ts,tsx,css,json,mjs}\" \".github/**/*.{yaml,yml}\" \"*.{json,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "3.9.8"
  }
}
